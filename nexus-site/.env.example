# Supabase frontend configuration — copy to .env.local and fill in.
#
# These are PUBLIC by design: the anon/publishable key is safe to ship
# to the browser because Row Level Security (not key secrecy) protects
# the database. See supabase/migrations/001_team_roster_admin.sql.
#
# NEVER put the service-role key in this file or in any VITE_* variable.
# The service-role key bypasses RLS and must stay server-side only.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
